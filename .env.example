# 이 파일을 복사해 .env로 저장한 뒤 값을 채우세요: cp .env.example .env
# .env는 git에 커밋되지 않습니다(.gitignore).

# --- 데이터베이스 ---
# Prisma Postgres 연결 문자열 (console.prisma.io에서 발급). 다른 Postgres 제공자를
# 쓰려면 해당 제공자의 connection string을 그대로 넣으면 됩니다.
# 반드시 로컬 개발 전용 DB를 사용하세요 — Vercel(운영) 환경 변수에 설정된 DATABASE_URL과
# 절대 같은 값을 쓰면 안 됩니다. 로컬에서 `npm run db:seed`/`db:reset`을 실행하면 해당 DB의
# 기존 데이터가 전부 삭제되므로, 운영 DB와 공유할 경우 실제 데이터가 날아갑니다.
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# 테스트 스위트 전용 Postgres DB (개발용 DATABASE_URL과 분리 — tests/setup.ts가 사용).
TEST_DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# --- 인증 ---
# 세션 JWT(HS256) 서명 키. 최소 32바이트 랜덤 값을 권장합니다.
# 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 운영 환경에서는 저장소에 커밋된 값을 그대로 쓰지 말고 반드시 새로 생성해 교체하세요.
AUTH_SECRET="change-me-with-a-generated-random-value"
